# Neon Postgres. Required for the shared, durable Admin catalog.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require

# Optional protection for Admin write operations.
# If set, the browser asks for this key when the first Admin change is saved.
ADMIN_SECRET=

PORT=3000

# Frontend consentiti a chiamare API e Socket.IO (separare più URL con una virgola).
CLIENT_ORIGIN=http://localhost:3000
